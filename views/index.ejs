    <script>

        /* ================= MOBILE MENU ================= */

        const menuBtn = document.getElementById("menuBtn");
        const navLinks = document.getElementById("navLinks");

        menuBtn.addEventListener("click", function () {

            navLinks.classList.toggle("show");

        });


        document
            .querySelectorAll(".nav-links a")
            .forEach(function (link) {

                link.addEventListener("click", function () {

                    navLinks.classList.remove("show");

                });

            });


        /* ================= RESULTS ================= */

        const results = {

            2026: [

                {
                    image: "/images/gudiya.jpeg",
                    title: "Gudiya Kumari • 403 marks "
                },

                {
                    image: "/images/jiya.jpeg",
                    title: "Jiya Kumari • 386 marks"
                },

                {
                    image: "/images/sanya.jpeg",
                    title: "Sanya Kumari • 366 marks"
                }

            ],

            2025: [

                {
                    image: "/images/jiya1.jpeg",
                    title: "2025 • 405 marks"
                },

                {
                    image: "/images/ananya.jpeg",
                    title: "2025 • 401 marks"
                },

                {
                    image: "/images/ayush.jpeg",
                    title: "2025 • 399 marks"
                }

            ]

        };


        const resultGrid =
            document.getElementById("resultGrid");


        function showResults(year) {

            resultGrid.innerHTML = "";

            results[year].forEach(function (result) {

                const card =
                    document.createElement("div");

                card.className = "result-card";

                card.innerHTML = `
                    <img
                        src="${result.image}"
                        alt="${result.title}"
                    >

                    <span class="result-title">
                        ${result.title}
                    </span>
                `;

                resultGrid.appendChild(card);

            });

        }


        document
            .querySelectorAll(".year-btn")
            .forEach(function (button) {

                button.addEventListener("click", function () {

                    document
                        .querySelectorAll(".year-btn")
                        .forEach(function (btn) {

                            btn.classList.remove("active");

                        });

                    button.classList.add("active");

                    showResults(button.dataset.year);

                });

            });


        showResults(2026);

    </script>

